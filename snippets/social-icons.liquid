{% doc %}
  Renders a row of social-media icon links, one per social_*_link theme
  setting that's actually filled in. Renders nothing if none are set.

  @example
  {% render 'social-icons' %}
{% enddoc %}

{%- liquid
  assign social_accounts = ''
  if settings.social_facebook_link != blank
    assign social_accounts = social_accounts | append: '1'
  endif
  if settings.social_instagram_link != blank
    assign social_accounts = social_accounts | append: '1'
  endif
  if settings.social_tiktok_link != blank
    assign social_accounts = social_accounts | append: '1'
  endif
  if settings.social_x_link != blank
    assign social_accounts = social_accounts | append: '1'
  endif
  if settings.social_youtube_link != blank
    assign social_accounts = social_accounts | append: '1'
  endif
  if settings.social_pinterest_link != blank
    assign social_accounts = social_accounts | append: '1'
  endif
-%}

{%- if social_accounts.size > 0 -%}
  <ul class="social-icons">
    {%- if settings.social_facebook_link != blank -%}
      <li>
        <a href="{{ settings.social_facebook_link }}" class="social-icons__link" target="_blank" rel="noopener">
          <span class="visually-hidden">{{ 'social.facebook' | t }}</span>
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13.5 21v-8h2.7l.4-3.1h-3.1V8c0-.9.25-1.5 1.55-1.5H16.7V3.7C16.4 3.65 15.4 3.55 14.3 3.55c-2.4 0-4 1.45-4 4.1V9.9H7.6V13h2.7v8h3.2z"/></svg>
        </a>
      </li>
    {%- endif -%}
    {%- if settings.social_instagram_link != blank -%}
      <li>
        <a href="{{ settings.social_instagram_link }}" class="social-icons__link" target="_blank" rel="noopener">
          <span class="visually-hidden">{{ 'social.instagram' | t }}</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><rect x="3.5" y="3.5" width="17" height="17" rx="4.5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r="0.75" fill="currentColor" stroke="none"/></svg>
        </a>
      </li>
    {%- endif -%}
    {%- if settings.social_tiktok_link != blank -%}
      <li>
        <a href="{{ settings.social_tiktok_link }}" class="social-icons__link" target="_blank" rel="noopener">
          <span class="visually-hidden">{{ 'social.tiktok' | t }}</span>
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16.5 3c.3 1.9 1.5 3.3 3.5 3.5v2.7c-1.3 0-2.5-.4-3.5-1.1v6.4c0 3.1-2.5 5.5-5.6 5.5S5.3 17.6 5.3 14.5c0-3 2.3-5.4 5.3-5.5v2.8c-1.4.1-2.5 1.3-2.5 2.7 0 1.5 1.2 2.7 2.7 2.7s2.8-1.2 2.8-2.7V3h2.9z"/></svg>
        </a>
      </li>
    {%- endif -%}
    {%- if settings.social_x_link != blank -%}
      <li>
        <a href="{{ settings.social_x_link }}" class="social-icons__link" target="_blank" rel="noopener">
          <span class="visually-hidden">{{ 'social.x' | t }}</span>
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4 4l7.1 9.3L4.3 20h2l6-6.5 4.5 6.5H20l-7.4-9.7L19.1 4h-2l-5.5 6L7 4H4z"/></svg>
        </a>
      </li>
    {%- endif -%}
    {%- if settings.social_youtube_link != blank -%}
      <li>
        <a href="{{ settings.social_youtube_link }}" class="social-icons__link" target="_blank" rel="noopener">
          <span class="visually-hidden">{{ 'social.youtube' | t }}</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><rect x="3" y="6" width="18" height="12" rx="3"/><path d="M10.5 9.5l4.5 2.5-4.5 2.5v-5z" fill="currentColor" stroke="none"/></svg>
        </a>
      </li>
    {%- endif -%}
    {%- if settings.social_pinterest_link != blank -%}
      <li>
        <a href="{{ settings.social_pinterest_link }}" class="social-icons__link" target="_blank" rel="noopener">
          <span class="visually-hidden">{{ 'social.pinterest' | t }}</span>
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 3.5c-4.7 0-8.5 3.5-8.5 7.9 0 3.1 1.8 5.2 3.1 5.2.4 0 .6-.2.7-.6l.3-1.1c.1-.3 0-.5-.2-.8-.5-.6-.9-1.3-.9-2.4 0-3 2.3-5.6 6-5.6 3.3 0 5.1 2 5.1 4.6 0 3.5-1.6 6.3-3.9 6.3-1.3 0-2.2-1-1.9-2.3.4-1.5 1.1-3.1 1.1-4.2 0-1-.5-1.8-1.6-1.8-1.2 0-2.2 1.3-2.2 3 0 1.1.4 1.8.4 1.8s-1.3 5.5-1.5 6.5c-.3 1.4-.1 3.1 0 3.6.1.2.3.3.4.1 1.4-2 1.9-3.9 2.3-4.9.2-.6.1-.4 1.1 0 .3.1.7.2 1.3.2 4.2 0 7.4-3.8 7.4-8.5 0-4.5-3.7-7.9-8.4-7.9z"/></svg>
        </a>
      </li>
    {%- endif -%}
  </ul>
{%- endif -%}

{% stylesheet %}
  .social-icons {
    display: flex;
    gap: 0.75rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .social-icons__link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    color: inherit;
  }
  .social-icons__link svg {
    width: 20px;
    height: 20px;
  }
{% endstylesheet %}
