{% doc %}
  Renders a faceted-filter sidebar (list/boolean/price_range types) shared
  by the collection and search result pages. Must be rendered inside a
  <form method="get"> that resubmits on change -- this snippet supplies
  that change listener plus the mobile drawer open/close behavior.

  @param {object[]} filters - collection.filters or search.filters

  @example
  {% render 'facet-filters', filters: collection.filters %}
{% enddoc %}

{%- if filters.size > 0 -%}
  <aside class="collection-filters" data-collection-filters>
    <div class="collection-filters__header">
      <p class="collection-filters__heading">{{ 'products.facets.filter_and_sort' | t }}</p>
      <button type="button" class="collection-filters__close" data-filters-close aria-label="{{ 'general.accessibility.close' | t }}">&times;</button>
    </div>

    {%- for filter in filters -%}
      <details class="filter-group" open>
        <summary>
          {{ filter.label }}
          {%- if filter.active_values.size > 0 -%}
            <span class="filter-group__count">({{ filter.active_values.size }})</span>
          {%- endif -%}
        </summary>
        <div class="filter-group__body">
          {%- case filter.type -%}
            {%- when 'list' -%}
              <ul class="filter-list">
                {%- for value in filter.values -%}
                  <li>
                    <label class="filter-checkbox">
                      <input
                        type="checkbox"
                        name="{{ value.param_name }}"
                        value="{{ value.value }}"
                        data-filter-input
                        {% if value.active %}checked{% endif %}
                        {% if value.count == 0 and value.active == false %}disabled{% endif %}
                      >
                      {{ value.label }} ({{ value.count }})
                    </label>
                  </li>
                {%- endfor -%}
              </ul>
            {%- when 'boolean' -%}
              <ul class="filter-list">
                <li>
                  <label class="filter-checkbox">
                    <input
                      type="checkbox"
                      name="{{ filter.true_value.param_name }}"
                      value="{{ filter.true_value.value }}"
                      data-filter-input
                      {% if filter.true_value.active %}checked{% endif %}
                    >
                    {{ filter.true_value.label }} ({{ filter.true_value.count }})
                  </label>
                </li>
              </ul>
            {%- when 'price_range' -%}
              <div class="filter-price-range">
                <label>
                  <span>{{ 'products.facets.from' | t }}</span>
                  <input
                    type="number"
                    name="{{ filter.min_value.param_name }}"
                    value="{{ filter.min_value.value }}"
                    placeholder="{{ filter.range_min | money_without_currency }}"
                    min="0"
                    data-filter-input
                  >
                </label>
                <label>
                  <span>{{ 'products.facets.to' | t }}</span>
                  <input
                    type="number"
                    name="{{ filter.max_value.param_name }}"
                    value="{{ filter.max_value.value }}"
                    placeholder="{{ filter.range_max | money_without_currency }}"
                    min="0"
                    data-filter-input
                  >
                </label>
              </div>
          {%- endcase -%}
        </div>
      </details>
    {%- endfor -%}

    <noscript>
      <button type="submit" class="button">{{ 'products.facets.apply' | t }}</button>
    </noscript>
  </aside>
{%- endif -%}

{% stylesheet %}
  .collection-filters__header {
    display: none;
  }
  .filter-group {
    border-bottom: 1px solid var(--color-border);
    padding: 0.75rem 0;
  }
  .filter-group summary {
    cursor: pointer;
    font-weight: 600;
  }
  .filter-group__count {
    color: var(--color-muted);
    font-weight: 400;
  }
  .filter-list {
    list-style: none;
    margin: 0.75rem 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .filter-checkbox {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9rem;
  }
  .filter-price-range {
    display: flex;
    gap: 0.75rem;
    margin-top: 0.75rem;
  }
  .filter-price-range label {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    font-size: 0.8rem;
    color: var(--color-muted);
  }
  .filter-price-range input {
    width: 100%;
    border: 1px solid var(--color-border);
    border-radius: var(--style-border-radius-inputs);
    padding: 0.4rem 0.5rem;
  }

  @media (max-width: 749px) {
    .collection-filters {
      position: fixed;
      inset: 0;
      z-index: 100;
      background: var(--color-background);
      padding: 1.5rem;
      overflow-y: auto;
      transform: translateX(-100%);
      transition: transform 0.2s ease;
    }
    .collection-filters.is-open {
      transform: translateX(0);
    }
    .collection-filters__header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 1rem;
    }
    .collection-filters__close {
      background: none;
      border: none;
      font-size: 1.5rem;
      line-height: 1;
    }
  }
{% endstylesheet %}

{% javascript %}
  document.addEventListener('change', function (e) {
    if (e.target.matches('[data-filter-input]')) {
      var form = e.target.closest('form');
      if (form) {
        if (form.requestSubmit) {
          form.requestSubmit();
        } else {
          form.submit();
        }
      }
    }
  });

  document.addEventListener('click', function (e) {
    if (e.target.closest('[data-filters-open]')) {
      var aside = document.querySelector('[data-collection-filters]');
      if (aside) aside.classList.add('is-open');
    }
    if (e.target.closest('[data-filters-close]')) {
      var aside = e.target.closest('[data-collection-filters]');
      if (aside) aside.classList.remove('is-open');
    }
  });
{% endjavascript %}
