[
  {
    "name": "theme_info",
    "theme_name": "Ease",
    "theme_version": "0.1.0",
    "theme_author": "LawrexIT Technology",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://support.shopify.com/"
  },
  {
    "name": "t:general.brand",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "t:labels.logo"
      },
      {
        "type": "range",
        "id": "logo_width",
        "min": 80,
        "max": 300,
        "step": 10,
        "unit": "px",
        "label": "t:labels.logo_width",
        "default": 140
      }
    ]
  },
  {
    "name": "t:general.typography",
    "settings": [
      {
        "type": "header",
        "content": "t:general.fonts"
      },
      {
        "type": "font_picker",
        "id": "type_heading_font",
        "default": "playfair_display_n6",
        "label": "t:labels.heading_font"
      },
      {
        "type": "font_picker",
        "id": "type_primary_font",
        "default": "inter_n4",
        "label": "t:general.primary"
      }
    ]
  },
  {
    "name": "t:general.layout",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "t:labels.page_width",
        "options": [
          {
            "value": "90rem",
            "label": "t:options.page_width.narrow"
          },
          {
            "value": "110rem",
            "label": "t:options.page_width.wide"
          }
        ],
        "default": "90rem"
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "min": 10,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "t:labels.page_margin",
        "default": 24
      },
      {
        "type": "range",
        "id": "card_corner_radius",
        "min": 0,
        "max": 32,
        "step": 2,
        "unit": "px",
        "label": "t:labels.card_corner_radius",
        "default": 16
      },
      {
        "type": "range",
        "id": "button_corner_radius",
        "min": 0,
        "max": 40,
        "step": 2,
        "unit": "px",
        "label": "t:labels.button_corner_radius",
        "default": 40
      }
    ]
  },
  {
    "name": "t:general.colors",
    "settings": [
      {
        "type": "color",
        "id": "background_color",
        "default": "#FCFBF9",
        "label": "t:labels.background"
      },
      {
        "type": "color",
        "id": "foreground_color",
        "default": "#0F172A",
        "label": "t:labels.foreground"
      },
      {
        "type": "color",
        "id": "muted_color",
        "default": "#475569",
        "label": "t:labels.muted",
        "info": "t:info.contrast_note"
      },
      {
        "type": "color",
        "id": "border_color",
        "default": "#E8E6E3",
        "label": "t:labels.border"
      },
      {
        "type": "color",
        "id": "accent_color",
        "default": "#4F6B5D",
        "label": "t:labels.accent",
        "info": "t:info.contrast_note"
      },
      {
        "type": "color",
        "id": "accent_foreground_color",
        "default": "#FFFFFF",
        "label": "t:labels.accent_foreground"
      },
      {
        "type": "color",
        "id": "sale_color",
        "default": "#92400E",
        "label": "t:labels.sale"
      },
      {
        "type": "range",
        "id": "input_corner_radius",
        "min": 0,
        "max": 10,
        "step": 1,
        "unit": "px",
        "label": "t:labels.input_corner_radius",
        "default": 8
      }
    ]
  }
]
