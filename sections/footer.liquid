<footer class="footer">
  <div class="footer__grid">
    <div class="footer__brand">
      <h2 class="footer__brand-name">{{ shop.name }}</h2>
      {%- if section.settings.tagline != blank -%}
        <p class="footer__tagline">{{ section.settings.tagline }}</p>
      {%- endif -%}
    </div>

    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'link_list' -%}
          <div class="footer__column" {{ block.shopify_attributes }}>
            {%- if block.settings.heading != blank -%}
              <h3 class="footer__heading">{{ block.settings.heading }}</h3>
            {%- endif -%}
            <ul class="footer__list">
              {%- for link in block.settings.menu.links -%}
                <li>{{ link.title | link_to: link.url }}</li>
              {%- endfor -%}
            </ul>
          </div>
        {%- when '@app' -%}
          {%- render block -%}
      {%- endcase -%}
    {%- endfor -%}
  </div>

  <div class="footer__bottom">
    <div class="footer__copyright">
      &copy; {{ 'now' | date: '%Y' }} {{ shop.name | link_to: routes.root_url }}, {{ powered_by_link }}
    </div>

    {%- liquid
      assign policies = shop.policies | where: 'body'
    -%}
    {%- if policies.size > 0 -%}
      <ul class="footer__policies">
        {%- for policy in policies -%}
          <li>{{ policy.title | link_to: policy.url }}</li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if section.settings.show_payment_icons -%}
      <div class="footer__payment">
        {%- for type in shop.enabled_payment_types -%}
          {{ type | payment_type_svg_tag }}
        {%- endfor -%}
      </div>
    {%- endif -%}

    <div class="footer__localization">
      {%- render 'localization-selectors' -%}
    </div>
  </div>
</footer>

{% stylesheet %}
  .footer {
    margin-top: 4rem;
    padding-top: 3rem;
    border-top: 1px solid var(--color-border);
  }
  .footer__grid {
    display: grid;
    grid-template-columns: 1.5fr repeat(3, 1fr);
    gap: 2rem;
  }
  .footer__brand-name {
    font-size: 1.1rem;
    margin: 0 0 0.5rem;
  }
  .footer__tagline {
    color: var(--color-muted);
    margin: 0;
    max-width: 32ch;
  }
  .footer__heading {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin: 0 0 1rem;
  }
  .footer__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .footer__list a {
    text-decoration: none;
    color: var(--color-foreground);
  }
  .footer__list a:hover {
    text-decoration: underline;
  }
  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: space-between;
    align-items: center;
    margin-top: 3rem;
    padding: 1.5rem 0;
    border-top: 1px solid var(--color-border);
    font-size: 0.8rem;
    color: var(--color-muted);
  }
  .footer__bottom a {
    color: inherit;
    text-decoration: none;
  }
  .footer__policies {
    list-style: none;
    display: flex;
    gap: 1rem;
    margin: 0;
    padding: 0;
    flex-wrap: wrap;
  }
  .footer__payment {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .footer__localization {
    display: flex;
    gap: 1rem;
  }

  @media (max-width: 749px) {
    .footer__grid {
      grid-template-columns: 1fr 1fr;
    }
    .footer__brand {
      grid-column: 1 / -1;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.footer",
  "settings": [
    {
      "type": "richtext",
      "id": "tagline",
      "label": "t:labels.text"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "t:labels.show_payment_icons",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "link_list",
      "name": "t:labels.menu",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:general.heading"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "t:labels.menu",
          "default": "footer"
        }
      ]
    },
    {
      "type": "@app"
    }
  ],
  "max_blocks": 6,
  "default": {
    "blocks": [
      { "type": "link_list" },
      { "type": "link_list" }
    ]
  }
}
{% endschema %}
