{% comment %}
  This section is used in the 404 template to render page shown when customers
  enter an invalid store URL.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/404
{% endcomment %}

<div class="error-page">
  <h1 class="error-page__title">{{ '404.title' | t }}</h1>
  <p class="error-page__message">{{ '404.not_found' | t }}</p>

  <form action="{{ routes.search_url }}" method="get" role="search" class="error-page__search">
    <input type="search" name="q" placeholder="{{ 'search.placeholder' | t }}" aria-label="{{ 'search.placeholder' | t }}">
    <button type="submit">{{ 'search.submit' | t }}</button>
  </form>

  <a href="{{ routes.all_products_collection_url }}" class="button error-page__cta">
    {{ '404.back_to_shopping' | t }}
  </a>
</div>

{% stylesheet %}
  .error-page {
    max-width: 32rem;
    margin: 4rem auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }
  .error-page__message {
    color: var(--color-muted);
    margin-bottom: 1rem;
  }
  .error-page__search {
    display: flex;
    gap: 0.75rem;
    width: 100%;
    max-width: 24rem;
  }
  .error-page__search input {
    flex: 1;
    border: 1px solid var(--color-border);
    border-radius: var(--style-border-radius-inputs);
    padding: 0.6rem 0.9rem;
  }
  .error-page__search button {
    border: 1px solid var(--color-foreground);
    background: var(--color-foreground);
    color: var(--color-background);
  }
  .error-page__cta {
    margin-top: 0.5rem;
    background: none;
    border: 1px solid var(--color-foreground);
    color: var(--color-foreground);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.404",
  "settings": []
}
{% endschema %}
