{% comment %}
  Main cart page: line items with options/selling plans/discounts, a cart
  note, cart-level discounts, subtotal, and checkout. Quantity and note
  changes progressively re-submit the form (full-page refresh, works with
  JS disabled too).

  https://shopify.dev/docs/storefronts/themes/architecture/templates/cart
{% endcomment %}

<div class="cart-page">
  <h1 class="cart-page__title">{{ 'cart.title' | t }}</h1>

  {%- if cart.item_count == 0 -%}
    <div class="cart-empty">
      <p>{{ 'cart.empty' | t }}</p>
      <a class="button" href="{{ routes.all_products_collection_url }}">{{ 'cart.continue_shopping' | t }}</a>
    </div>
  {%- else -%}
    <form action="{{ routes.cart_url }}" method="post" id="CartForm" data-cart-form>
      <ul class="cart-items" role="list">
        {%- for item in cart.items -%}
          <li class="cart-item" data-cart-item>
            <a href="{{ item.url }}" class="cart-item__media">
              {%- render 'image', image: item.image, width: 200, height: 200, crop: 'center' -%}
            </a>
            <div class="cart-item__details">
              <a href="{{ item.url }}" class="cart-item__title">{{ item.product.title | escape }}</a>

              {%- unless item.product.has_only_default_variant -%}
                <ul class="cart-item__options">
                  {%- for option in item.options_with_values -%}
                    <li>{{ option.name }}: {{ option.value }}</li>
                  {%- endfor -%}
                </ul>
              {%- endunless -%}

              {%- if item.selling_plan_allocation -%}
                <p class="cart-item__selling-plan">{{ item.selling_plan_allocation.selling_plan.name }}</p>
              {%- endif -%}

              {%- if item.line_level_discount_allocations.size > 0 -%}
                <ul class="cart-item__discounts">
                  {%- for discount_allocation in item.line_level_discount_allocations -%}
                    <li>{{ discount_allocation.discount_application.title }} (-{{ discount_allocation.amount | money }})</li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}

              <a class="cart-item__remove" href="{{ item.url_to_remove }}">{{ 'cart.remove' | t }}</a>
            </div>

            <div class="cart-item__quantity">
              <button type="button" class="quantity-selector__button" data-quantity-minus aria-label="{{ 'products.product.quantity_decrease' | t }}">&minus;</button>
              <input
                type="number"
                class="quantity-selector__input"
                name="updates[]"
                value="{{ item.quantity }}"
                min="0"
                aria-label="{{ 'products.product.quantity' | t }}"
                data-quantity-input
              >
              <button type="button" class="quantity-selector__button" data-quantity-plus aria-label="{{ 'products.product.quantity_increase' | t }}">&plus;</button>
            </div>

            <div class="cart-item__price">
              {%- if item.original_line_price != item.final_line_price -%}
                <span class="cart-item__price-compare">{{ item.original_line_price | money }}</span>
              {%- endif -%}
              <span>{{ item.final_line_price | money }}</span>
            </div>
          </li>
        {%- endfor -%}
      </ul>

      <noscript>
        <button type="submit" class="button">{{ 'cart.update' | t }}</button>
      </noscript>

      {%- if section.settings.enable_cart_note -%}
        <div class="cart-note">
          <label for="CartNote">{{ 'cart.note' | t }}</label>
          <textarea id="CartNote" name="note" rows="3">{{ cart.note }}</textarea>
        </div>
      {%- endif -%}

      <div class="cart-summary">
        {%- if cart.cart_level_discount_applications.size > 0 -%}
          <ul class="cart-summary__discounts">
            {%- for discount_application in cart.cart_level_discount_applications -%}
              <li>{{ discount_application.title }} (-{{ discount_application.total_allocated_amount | money }})</li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        <div class="cart-summary__row cart-summary__row--total">
          <span>{{ 'cart.subtotal' | t }}</span>
          <span>{{ cart.total_price | money }}</span>
        </div>
        <p class="cart-summary__note">{{ 'cart.taxes_and_shipping_at_checkout' | t }}</p>

        <button type="submit" name="checkout" class="button cart-summary__checkout">{{ 'cart.checkout' | t }}</button>
        <a class="cart-summary__continue" href="{{ routes.all_products_collection_url }}">{{ 'cart.continue_shopping' | t }}</a>
      </div>
    </form>
  {%- endif -%}
</div>

{% stylesheet %}
  .cart-page__title {
    margin-bottom: 1.5rem;
  }
  .cart-empty {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
    padding: 2rem 0;
  }
  .cart-items {
    list-style: none;
    margin: 0 0 2rem;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .cart-item {
    display: grid;
    grid-template-columns: 96px 1fr auto auto;
    gap: 1.25rem;
    align-items: start;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--color-border);
  }
  .cart-item__media {
    display: block;
    width: 96px;
    border-radius: var(--style-border-radius-card);
    overflow: hidden;
  }
  .cart-item__details {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .cart-item__title {
    font-weight: 600;
    color: inherit;
    text-decoration: none;
  }
  .cart-item__options,
  .cart-item__discounts {
    list-style: none;
    margin: 0;
    padding: 0;
    color: var(--color-muted);
    font-size: 0.85rem;
  }
  .cart-item__selling-plan {
    margin: 0;
    font-size: 0.85rem;
    color: var(--color-accent);
  }
  .cart-item__remove {
    font-size: 0.8rem;
    color: var(--color-muted);
    text-decoration: underline;
    width: fit-content;
  }
  .cart-item__quantity {
    display: flex;
    align-items: center;
    border: 1px solid var(--color-border);
    border-radius: var(--style-border-radius-button);
    height: fit-content;
  }
  .quantity-selector__button {
    background: none;
    border: none;
    min-width: 40px;
    min-height: 40px;
  }
  .quantity-selector__input {
    width: 3ch;
    border: none;
    text-align: center;
    background: none;
    -moz-appearance: textfield;
  }
  .quantity-selector__input::-webkit-outer-spin-button,
  .quantity-selector__input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }
  .cart-item__price {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    font-weight: 600;
    white-space: nowrap;
  }
  .cart-item__price-compare {
    font-weight: 400;
    color: var(--color-muted);
    text-decoration: line-through;
    font-size: 0.85rem;
  }
  .cart-note {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    max-width: 32rem;
    margin-bottom: 2rem;
  }
  .cart-note textarea {
    border: 1px solid var(--color-border);
    border-radius: var(--style-border-radius-inputs);
    padding: 0.6rem;
    font: inherit;
  }
  .cart-summary {
    max-width: 24rem;
    margin-left: auto;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .cart-summary__discounts {
    list-style: none;
    margin: 0;
    padding: 0;
    color: var(--color-accent);
    font-size: 0.85rem;
  }
  .cart-summary__row {
    display: flex;
    justify-content: space-between;
  }
  .cart-summary__row--total {
    font-size: 1.15rem;
    font-weight: 700;
  }
  .cart-summary__note {
    margin: 0;
    color: var(--color-muted);
    font-size: 0.8rem;
  }
  .cart-summary__checkout {
    margin-top: 0.5rem;
  }
  .cart-summary__continue {
    text-align: center;
    font-size: 0.85rem;
    color: var(--color-muted);
    text-decoration: underline;
  }

  @media (max-width: 749px) {
    .cart-item {
      grid-template-columns: 72px 1fr;
      grid-template-areas:
        "media details"
        "media quantity"
        "media price";
    }
    .cart-item__media {
      grid-area: media;
      width: 72px;
    }
    .cart-item__details {
      grid-area: details;
    }
    .cart-item__quantity {
      grid-area: quantity;
    }
    .cart-item__price {
      grid-area: price;
      align-items: flex-start;
    }
    .cart-summary {
      max-width: none;
      margin-left: 0;
    }
  }
{% endstylesheet %}

{% javascript %}
  document.querySelectorAll('[data-cart-form]').forEach(function (form) {
    form.querySelectorAll('[data-cart-item]').forEach(function (row) {
      var input = row.querySelector('[data-quantity-input]');
      var minus = row.querySelector('[data-quantity-minus]');
      var plus = row.querySelector('[data-quantity-plus]');
      if (!input || !minus || !plus) return;

      minus.addEventListener('click', function () {
        input.value = Math.max(0, (parseInt(input.value, 10) || 0) - 1);
        input.dispatchEvent(new Event('change', { bubbles: true }));
      });
      plus.addEventListener('click', function () {
        input.value = (parseInt(input.value, 10) || 0) + 1;
        input.dispatchEvent(new Event('change', { bubbles: true }));
      });
    });

    form.addEventListener('change', function (e) {
      if (e.target.matches('[data-quantity-input]')) {
        if (form.requestSubmit) {
          form.requestSubmit();
        } else {
          form.submit();
        }
      }
    });
  });
{% endjavascript %}

{% schema %}
{
  "name": "t:general.cart",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_cart_note",
      "label": "t:labels.enable_cart_note",
      "default": true
    }
  ]
}
{% endschema %}
