{% comment %}
  Main collection page: title/description, faceted filtering, sorting,
  a responsive product grid, and pagination.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/collection
{% endcomment %}

<div class="collection-page">
  <div class="collection-header">
    <h1 class="collection-header__title">{{ collection.title }}</h1>
    {%- if collection.description != blank -%}
      <div class="collection-header__description rte">{{ collection.description }}</div>
    {%- endif -%}
  </div>

  <form
    id="FacetFilterForm-{{ section.id }}"
    class="collection-layout"
    method="get"
    action="{{ collection.url }}"
    data-facet-form
  >
    {%- if section.settings.enable_filtering -%}
      {%- render 'facet-filters', filters: collection.filters -%}
    {%- endif -%}

    <div class="collection-main">
      <div class="collection-toolbar">
        {%- if collection.filters.size > 0 -%}
          <button type="button" class="collection-toolbar__filter-toggle" data-filters-open>
            {{ 'products.facets.filter_and_sort' | t }}
          </button>
        {%- endif -%}
        <p class="collection-toolbar__count">{{ 'products.facets.product_count' | t: count: collection.products_count }}</p>
        {%- if section.settings.enable_sorting -%}
          {%- assign current_sort = collection.sort_by | default: collection.default_sort_by -%}
          {%- render 'facet-sort',
            sort_options: collection.sort_options,
            current_sort: current_sort,
            unique_id: section.id
          -%}
        {%- endif -%}
      </div>

      {%- render 'active-filters', filters: collection.filters, clear_url: collection.url -%}

      {%- paginate collection.products by section.settings.products_per_page -%}
        {%- if collection.products.size > 0 -%}
          <div class="product-grid" style="--columns-desktop: {{ section.settings.columns_desktop }}">
            {%- for product in collection.products -%}
              {%- render 'product-card', product: product -%}
            {%- endfor -%}
          </div>
          {{ paginate | default_pagination }}
        {%- else -%}
          <p class="collection-empty">{{ 'products.facets.no_matches' | t }}</p>
        {%- endif -%}
      {%- endpaginate -%}
    </div>
  </form>
</div>

{% stylesheet %}
  .collection-header {
    margin-bottom: 2rem;
  }
  .collection-header__title {
    margin-bottom: 0.5rem;
  }
  .collection-header__description {
    color: var(--color-muted);
    max-width: 60ch;
  }
  .collection-layout {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 2.5rem;
    align-items: start;
  }
  .collection-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
  }
  .collection-toolbar__filter-toggle {
    display: none;
    background: none;
    border: 1px solid var(--color-border);
    border-radius: var(--style-border-radius-button);
    padding: 0.5rem 1rem;
  }
  .collection-toolbar__count {
    margin: 0;
    color: var(--color-muted);
    font-size: 0.9rem;
  }
  .product-grid {
    display: grid;
    grid-template-columns: repeat(var(--columns-desktop, 4), 1fr);
    gap: 1.5rem 1.25rem;
  }
  .collection-empty {
    color: var(--color-muted);
    padding: 3rem 0;
    text-align: center;
  }

  @media (max-width: 989px) {
    .product-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 749px) {
    .collection-layout {
      grid-template-columns: 1fr;
    }
    .collection-toolbar__filter-toggle {
      display: inline-block;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.collection",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "min": 8,
      "max": 48,
      "step": 4,
      "label": "t:labels.products_per_page",
      "default": 16
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "t:labels.columns_desktop",
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "label": "t:labels.enable_filtering",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_sorting",
      "label": "t:labels.enable_sorting",
      "default": true
    }
  ]
}
{% endschema %}
