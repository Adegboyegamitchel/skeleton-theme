{% comment %}
  Main collection page: title/description, faceted filtering, sorting,
  a responsive product grid, and pagination.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/collection
{% endcomment %}

{%- liquid
  assign sort_options = 'manual,best-selling,title-ascending,title-descending,price-ascending,price-descending,created-descending,created-ascending' | split: ','
  assign has_active_filters = false
  for filter in collection.filters
    if filter.type == 'price_range'
      if filter.min_value.value or filter.max_value.value
        assign has_active_filters = true
      endif
    elsif filter.active_values.size > 0
      assign has_active_filters = true
    endif
  endfor
-%}

<div class="collection-page">
  <div class="collection-header">
    <h1 class="collection-header__title">{{ collection.title }}</h1>
    {%- if collection.description != blank -%}
      <div class="collection-header__description rte">{{ collection.description }}</div>
    {%- endif -%}
  </div>

  <form
    id="FacetFilterForm-{{ section.id }}"
    class="collection-layout"
    method="get"
    action="{{ collection.url }}"
    data-facet-form
  >
    {%- if section.settings.enable_filtering and collection.filters.size > 0 -%}
      <aside class="collection-filters" data-collection-filters>
        <div class="collection-filters__header">
          <p class="collection-filters__heading">{{ 'products.facets.filter_and_sort' | t }}</p>
          <button type="button" class="collection-filters__close" data-filters-close aria-label="{{ 'general.accessibility.close' | t }}">&times;</button>
        </div>

        {%- for filter in collection.filters -%}
          <details class="filter-group" open>
            <summary>
              {{ filter.label }}
              {%- if filter.active_values.size > 0 -%}
                <span class="filter-group__count">({{ filter.active_values.size }})</span>
              {%- endif -%}
            </summary>
            <div class="filter-group__body">
              {%- case filter.type -%}
                {%- when 'list' -%}
                  <ul class="filter-list">
                    {%- for value in filter.values -%}
                      <li>
                        <label class="filter-checkbox">
                          <input
                            type="checkbox"
                            name="{{ value.param_name }}"
                            value="{{ value.value }}"
                            data-filter-input
                            {% if value.active %}checked{% endif %}
                            {% if value.count == 0 and value.active == false %}disabled{% endif %}
                          >
                          {{ value.label }} ({{ value.count }})
                        </label>
                      </li>
                    {%- endfor -%}
                  </ul>
                {%- when 'boolean' -%}
                  <ul class="filter-list">
                    <li>
                      <label class="filter-checkbox">
                        <input
                          type="checkbox"
                          name="{{ filter.true_value.param_name }}"
                          value="{{ filter.true_value.value }}"
                          data-filter-input
                          {% if filter.true_value.active %}checked{% endif %}
                        >
                        {{ filter.true_value.label }} ({{ filter.true_value.count }})
                      </label>
                    </li>
                  </ul>
                {%- when 'price_range' -%}
                  <div class="filter-price-range">
                    <label>
                      <span>{{ 'products.facets.from' | t }}</span>
                      <input
                        type="number"
                        name="{{ filter.min_value.param_name }}"
                        value="{{ filter.min_value.value }}"
                        placeholder="{{ filter.range_min | money_without_currency }}"
                        min="0"
                        data-filter-input
                      >
                    </label>
                    <label>
                      <span>{{ 'products.facets.to' | t }}</span>
                      <input
                        type="number"
                        name="{{ filter.max_value.param_name }}"
                        value="{{ filter.max_value.value }}"
                        placeholder="{{ filter.range_max | money_without_currency }}"
                        min="0"
                        data-filter-input
                      >
                    </label>
                  </div>
              {%- endcase -%}
            </div>
          </details>
        {%- endfor -%}

        <noscript>
          <button type="submit" class="button">{{ 'products.facets.apply' | t }}</button>
        </noscript>
      </aside>
    {%- endif -%}

    <div class="collection-main">
      <div class="collection-toolbar">
        <button type="button" class="collection-toolbar__filter-toggle" data-filters-open>
          {{ 'products.facets.filter_and_sort' | t }}
        </button>
        <p class="collection-toolbar__count">{{ 'products.facets.product_count' | t: count: collection.products_count }}</p>
        {%- if section.settings.enable_sorting -%}
          <div class="collection-sort">
            <label for="SortBy-{{ section.id }}">{{ 'products.facets.sort_by' | t }}</label>
            <select name="sort_by" id="SortBy-{{ section.id }}" data-sort-select>
              {%- for option in sort_options -%}
                {%- liquid
                  assign current_sort = collection.sort_by | default: collection.default_sort_by
                  case option
                    when 'manual'
                      assign option_label = 'products.facets.sort_options.manual' | t
                    when 'best-selling'
                      assign option_label = 'products.facets.sort_options.best_selling' | t
                    when 'title-ascending'
                      assign option_label = 'products.facets.sort_options.title_ascending' | t
                    when 'title-descending'
                      assign option_label = 'products.facets.sort_options.title_descending' | t
                    when 'price-ascending'
                      assign option_label = 'products.facets.sort_options.price_ascending' | t
                    when 'price-descending'
                      assign option_label = 'products.facets.sort_options.price_descending' | t
                    when 'created-descending'
                      assign option_label = 'products.facets.sort_options.created_descending' | t
                    when 'created-ascending'
                      assign option_label = 'products.facets.sort_options.created_ascending' | t
                  endcase
                -%}
                <option value="{{ option }}" {% if current_sort == option %}selected{% endif %}>{{ option_label }}</option>
              {%- endfor -%}
            </select>
          </div>
        {%- endif -%}
      </div>

      {%- if has_active_filters -%}
        <div class="active-filters">
          {%- for filter in collection.filters -%}
            {%- if filter.type == 'price_range' -%}
              {%- if filter.min_value.value or filter.max_value.value -%}
                <a class="active-filter" href="{{ filter.url_to_remove }}">
                  {{ filter.label }}: {{ filter.min_value.value | default: filter.range_min | money }} - {{ filter.max_value.value | default: filter.range_max | money }}
                  <span aria-hidden="true">&times;</span>
                </a>
              {%- endif -%}
            {%- else -%}
              {%- for value in filter.active_values -%}
                <a class="active-filter" href="{{ value.url_to_remove }}">
                  {{ filter.label }}: {{ value.label }}
                  <span aria-hidden="true">&times;</span>
                </a>
              {%- endfor -%}
            {%- endif -%}
          {%- endfor -%}
          <a class="active-filters__clear" href="{{ collection.url }}?sort_by={{ collection.sort_by }}">{{ 'products.facets.clear_all' | t }}</a>
        </div>
      {%- endif -%}

      {%- paginate collection.products by section.settings.products_per_page -%}
        {%- if collection.products.size > 0 -%}
          <div class="product-grid" style="--columns-desktop: {{ section.settings.columns_desktop }}">
            {%- for product in collection.products -%}
              {%- render 'product-card', product: product -%}
            {%- endfor -%}
          </div>
          {{ paginate | default_pagination }}
        {%- else -%}
          <p class="collection-empty">{{ 'products.facets.no_matches' | t }}</p>
        {%- endif -%}
      {%- endpaginate -%}
    </div>
  </form>
</div>

{% stylesheet %}
  .collection-header {
    margin-bottom: 2rem;
  }
  .collection-header__title {
    margin-bottom: 0.5rem;
  }
  .collection-header__description {
    color: var(--color-muted);
    max-width: 60ch;
  }
  .collection-layout {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 2.5rem;
    align-items: start;
  }
  .collection-filters__header {
    display: none;
  }
  .filter-group {
    border-bottom: 1px solid var(--color-border);
    padding: 0.75rem 0;
  }
  .filter-group summary {
    cursor: pointer;
    font-weight: 600;
  }
  .filter-group__count {
    color: var(--color-muted);
    font-weight: 400;
  }
  .filter-list {
    list-style: none;
    margin: 0.75rem 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .filter-checkbox {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9rem;
  }
  .filter-price-range {
    display: flex;
    gap: 0.75rem;
    margin-top: 0.75rem;
  }
  .filter-price-range label {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    font-size: 0.8rem;
    color: var(--color-muted);
  }
  .filter-price-range input {
    width: 100%;
    border: 1px solid var(--color-border);
    border-radius: var(--style-border-radius-inputs);
    padding: 0.4rem 0.5rem;
  }
  .collection-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
  }
  .collection-toolbar__filter-toggle {
    display: none;
    background: none;
    border: 1px solid var(--color-border);
    border-radius: var(--style-border-radius-button);
    padding: 0.5rem 1rem;
  }
  .collection-toolbar__count {
    margin: 0;
    color: var(--color-muted);
    font-size: 0.9rem;
  }
  .collection-sort {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9rem;
    margin-left: auto;
  }
  .collection-sort select {
    border: 1px solid var(--color-border);
    border-radius: var(--style-border-radius-inputs);
    padding: 0.4rem 0.6rem;
    background: var(--color-background);
    color: var(--color-foreground);
  }
  .active-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
  }
  .active-filter {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.8rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 0.3rem 0.75rem;
    color: inherit;
    text-decoration: none;
  }
  .active-filters__clear {
    font-size: 0.8rem;
    color: var(--color-muted);
    align-self: center;
    text-decoration: underline;
  }
  .product-grid {
    display: grid;
    grid-template-columns: repeat(var(--columns-desktop, 4), 1fr);
    gap: 1.5rem 1.25rem;
  }
  .collection-empty {
    color: var(--color-muted);
    padding: 3rem 0;
    text-align: center;
  }

  @media (max-width: 989px) {
    .product-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 749px) {
    .collection-layout {
      grid-template-columns: 1fr;
    }
    .collection-toolbar__filter-toggle {
      display: inline-block;
    }
    .collection-filters {
      position: fixed;
      inset: 0;
      z-index: 100;
      background: var(--color-background);
      padding: 1.5rem;
      overflow-y: auto;
      transform: translateX(-100%);
      transition: transform 0.2s ease;
    }
    .collection-filters.is-open {
      transform: translateX(0);
    }
    .collection-filters__header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 1rem;
    }
    .collection-filters__close {
      background: none;
      border: none;
      font-size: 1.5rem;
      line-height: 1;
    }
  }
{% endstylesheet %}

{% javascript %}
  document.querySelectorAll('[data-facet-form]').forEach(function (form) {
    form.addEventListener('change', function (e) {
      if (e.target.matches('[data-filter-input], [data-sort-select]')) {
        if (form.requestSubmit) {
          form.requestSubmit();
        } else {
          form.submit();
        }
      }
    });

    var filters = form.querySelector('[data-collection-filters]');
    var openButton = form.querySelector('[data-filters-open]');
    var closeButton = form.querySelector('[data-filters-close]');
    if (filters && openButton && closeButton) {
      openButton.addEventListener('click', function () {
        filters.classList.add('is-open');
      });
      closeButton.addEventListener('click', function () {
        filters.classList.remove('is-open');
      });
    }
  });
{% endjavascript %}

{% schema %}
{
  "name": "t:general.collection",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "min": 8,
      "max": 48,
      "step": 4,
      "label": "t:labels.products_per_page",
      "default": 16
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "t:labels.columns_desktop",
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "label": "t:labels.enable_filtering",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_sorting",
      "label": "t:labels.enable_sorting",
      "default": true
    }
  ]
}
{% endschema %}
