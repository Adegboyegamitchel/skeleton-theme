{% comment %}
  This section is used in the password template to render landing page shown
  when password protection is applied to a store.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/password
{% endcomment %}

<div class="password-page">
  <h1 class="password-page__title">{{ shop.name }}</h1>

  {%- if shop.password_message != blank -%}
    <div class="password-page__message rte">{{ shop.password_message }}</div>
  {%- endif -%}

  <div class="password-page__forms">
    <div class="password-page__enter">
      <h2>{{ 'password.title' | t }}</h2>
      {%- form 'storefront_password' -%}
        {{ form.errors | default_errors }}

        <div class="form-field">
          <label for="password-input">{{ 'password.password' | t }}</label>
          <input type="password" name="password" id="password-input">
        </div>

        <button type="submit" class="button">{{ 'password.enter' | t }}</button>
      {%- endform -%}
    </div>

    <div class="password-page__notify">
      <h2>{{ 'password.notify_title' | t }}</h2>
      {%- form 'customer' -%}
        {{ form.errors | default_errors }}

        {%- if form.posted_successfully? -%}
          <p class="password-page__success">{{ 'password.notify_success' | t }}</p>
        {%- endif -%}

        <input type="hidden" name="contact[tags]" value="prospect, password page">

        <div class="form-field">
          <label for="password-email" class="visually-hidden">{{ 'password.notify_email' | t }}</label>
          <input
            type="email"
            name="contact[email]"
            id="password-email"
            placeholder="{{ 'password.notify_email' | t }}"
            autocomplete="email"
            required
          >
        </div>

        <button type="submit" class="button">{{ 'password.notify_submit' | t }}</button>
      {%- endform -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .password-page {
    max-width: 32rem;
    margin: 6rem auto;
    text-align: center;
  }
  .password-page__title {
    margin-bottom: 1rem;
  }
  .password-page__message {
    color: var(--color-muted);
    margin-bottom: 2rem;
  }
  .password-page__forms {
    display: grid;
    gap: 2.5rem;
    text-align: left;
  }
  .password-page__forms h2 {
    font-size: 1.1rem;
    margin-bottom: 1rem;
  }
  .password-page__success {
    color: var(--color-accent);
    margin-bottom: 0.75rem;
  }
  .form-field {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    margin-bottom: 1rem;
  }
  .form-field input {
    border: 1px solid var(--color-border);
    padding: 0.6rem 0.75rem;
    font: inherit;
    width: 100%;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.password",
  "settings": []
}
{% endschema %}
