{% comment %}
  Predictive-search results panel. Rendered on demand via the Predictive
  Search API (see assets/predictive-search.js and the search flyout in
  header.liquid) -- not wired into any template.

  https://shopify.dev/docs/storefronts/themes/navigation-search/search/predictive-search
{% endcomment %}

{%- if predictive_search.performed -%}
  <div id="predictive-search-results" class="predictive-search-results">
    {%- assign products = predictive_search.resources.products -%}
    {%- assign pages_and_articles = predictive_search.resources.pages | concat: predictive_search.resources.articles -%}

    {%- if products.size > 0 -%}
      <p class="predictive-search-results__heading" id="PredictiveSearchProducts">{{ 'search.tab_products' | t }}</p>
      <ul role="listbox" aria-labelledby="PredictiveSearchProducts" class="predictive-search-results__list">
        {%- for product in products -%}
          {%- liquid
            assign price_display = product.price_min | money
          -%}
          <li role="option">
            <a href="{{ product.url }}" class="predictive-search-result">
              {%- if product.featured_image -%}
                {{ product.featured_image | image_url: width: 80 | image_tag: width: 80, height: 80, loading: 'lazy' }}
              {%- endif -%}
              <span class="predictive-search-result__content">
                <span class="predictive-search-result__title">{{ product.title | escape }}</span>
                <span class="predictive-search-result__price">
                  {%- if product.price_varies -%}
                    {{ 'products.facets.from_price_html' | t: price: price_display }}
                  {%- else -%}
                    {{ price_display }}
                  {%- endif -%}
                </span>
              </span>
            </a>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if pages_and_articles.size > 0 -%}
      <p class="predictive-search-results__heading" id="PredictiveSearchContent">{{ 'search.tab_pages_articles' | t }}</p>
      <ul role="listbox" aria-labelledby="PredictiveSearchContent" class="predictive-search-results__list">
        {%- for item in pages_and_articles -%}
          <li role="option">
            <a href="{{ item.url }}" class="predictive-search-result predictive-search-result--text">
              <span class="predictive-search-result__title">{{ item.title | escape }}</span>
            </a>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if products.size == 0 and pages_and_articles.size == 0 -%}
      <p class="predictive-search-results__empty">{{ 'search.no_results_html' | t: terms: predictive_search.terms }}</p>
    {%- else -%}
      <a class="predictive-search-results__view-all" href="{{ routes.search_url }}?q={{ predictive_search.terms | url_param_escape }}">
        {{ 'search.view_all_results_html' | t: terms: predictive_search.terms }}
      </a>
    {%- endif -%}
  </div>
{%- endif -%}

{% stylesheet %}
  .predictive-search-results {
    padding: 0.75rem 0;
  }
  .predictive-search-results__heading {
    margin: 0.5rem 1rem 0.25rem;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-muted);
  }
  .predictive-search-results__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .predictive-search-result {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem 1rem;
    color: inherit;
    text-decoration: none;
  }
  .predictive-search-result:hover {
    background: color-mix(in srgb, var(--color-foreground) 5%, transparent);
  }
  .predictive-search-result img {
    width: 48px;
    height: 48px;
    object-fit: cover;
    border-radius: var(--style-border-radius-inputs);
    flex-shrink: 0;
  }
  .predictive-search-result__content {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .predictive-search-result__title {
    font-size: 0.9rem;
  }
  .predictive-search-result__price {
    font-size: 0.8rem;
    color: var(--color-muted);
  }
  .predictive-search-results__empty {
    margin: 0;
    padding: 0.75rem 1rem;
    color: var(--color-muted);
    font-size: 0.9rem;
  }
  .predictive-search-results__view-all {
    display: block;
    margin: 0.5rem 1rem 0;
    padding-top: 0.75rem;
    border-top: 1px solid var(--color-border);
    font-size: 0.85rem;
    text-decoration: underline;
    color: inherit;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.predictive_search",
  "settings": []
}
{% endschema %}
