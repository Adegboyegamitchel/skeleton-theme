{% comment %}
  Newsletter signup: captures an email via Shopify's built-in customer
  form, tagging the resulting customer "newsletter" so merchants can
  target subscribers.

  https://shopify.dev/docs/storefronts/themes/customer-engagement/email-consent
{% endcomment %}

<div class="newsletter">
  {%- if section.settings.heading != blank -%}
    <h2 class="newsletter__heading">{{ section.settings.heading }}</h2>
  {%- endif -%}
  {%- if section.settings.subheading != blank -%}
    <p class="newsletter__subheading">{{ section.settings.subheading }}</p>
  {%- endif -%}

  {%- form 'customer', id: 'NewsletterForm', class: 'newsletter__form' -%}
    {{ form.errors | default_errors }}

    {%- if form.posted_successfully? -%}
      <p class="newsletter__success">{{ 'newsletter.success' | t }}</p>
    {%- else -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <label for="NewsletterEmail-{{ section.id }}" class="visually-hidden">{{ 'newsletter.email' | t }}</label>
      <input
        type="email"
        name="contact[email]"
        id="NewsletterEmail-{{ section.id }}"
        placeholder="{{ 'newsletter.email' | t }}"
        autocomplete="email"
        required
      >
      <button type="submit" class="button">{{ 'newsletter.submit' | t }}</button>
    {%- endif -%}
  {%- endform -%}
</div>

{% stylesheet %}
  .newsletter {
    text-align: center;
    max-width: 32rem;
    margin: 0 auto;
    padding: 3rem 0;
  }
  .newsletter__heading {
    margin-bottom: 0.5rem;
  }
  .newsletter__subheading {
    color: var(--color-muted);
    margin-bottom: 1.5rem;
  }
  .newsletter__form {
    display: flex;
    gap: 0.75rem;
    justify-content: center;
  }
  .newsletter__form input[type='email'] {
    flex: 1;
    max-width: 20rem;
    border: 1px solid var(--color-border);
    border-radius: var(--style-border-radius-inputs);
    padding: 0.6rem 0.9rem;
  }
  .newsletter__success {
    color: var(--color-accent);
    margin: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.newsletter",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:general.heading",
      "default": "Stay in the loop"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:labels.subheading",
      "default": "Get news on new arrivals and offers."
    }
  ],
  "presets": [
    {
      "name": "t:general.newsletter"
    }
  ]
}
{% endschema %}
