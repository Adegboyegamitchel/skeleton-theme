<header class="header">
  <button
    type="button"
    class="header__menu-toggle"
    aria-expanded="false"
    aria-controls="MobileNav-{{ section.id }}"
    data-mobile-nav-toggle
  >
    <span class="visually-hidden">{{ 'general.accessibility.menu' | t }}</span>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18" stroke-linecap="round"/></svg>
  </button>

  <h2 class="header__title">
    <a href="{{ routes.root_url }}">
      {%- if settings.logo -%}
        {{ settings.logo | image_url: width: settings.logo_width | image_tag: alt: shop.name, widths: '80,140,200,300', loading: 'eager' }}
      {%- else -%}
        {{ shop.name }}
      {%- endif -%}
    </a>
  </h2>

  <nav class="header__menu" aria-label="{{ 'general.accessibility.primary_navigation' | t }}">
    <ul>
      {% for link in section.settings.menu.links %}
        <li class="header__menu-item{% if link.links.size > 0 %} has-submenu{% endif %}">
          {% if link.links.size > 0 %}
            <button type="button" class="header__menu-link" aria-expanded="false" aria-haspopup="true">
              {{ link.title }}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
            <ul class="header__submenu">
              {% for childlink in link.links %}
                <li>{{ childlink.title | link_to: childlink.url }}</li>
              {% endfor %}
            </ul>
          {% else %}
            {{ link.title | link_to: link.url }}
          {% endif %}
        </li>
      {% endfor %}
    </ul>
  </nav>

  <div class="header__icons">
    <button type="button" class="header__icon-link header__search-toggle" data-search-toggle>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4" stroke-linecap="round"/></svg>
      <span class="visually-hidden">{{ 'general.accessibility.search' | t }}</span>
    </button>

    {% if shop.customer_accounts_enabled %}
      <shopify-account menu="{{ section.settings.customer_account_menu }}" class="header__icon-link">
        {{ 'icon-account.svg' | inline_asset_content }}
        <span class="visually-hidden">{{ 'general.accessibility.account' | t }}</span>
      </shopify-account>
    {% endif %}

    <a href="{{ routes.cart_url }}" class="header__icon-link">
      {% if cart.item_count > 0 %}
        <sup>{{ cart.item_count }}</sup>
      {% endif %}
      {{ 'icon-cart.svg' | inline_asset_content }}
      <span class="visually-hidden">{{ 'general.accessibility.cart' | t }}</span>
    </a>
  </div>

  <div class="mobile-nav" id="MobileNav-{{ section.id }}" aria-hidden="true" data-mobile-nav>
    <div class="mobile-nav__overlay" data-mobile-nav-overlay></div>
    <div class="mobile-nav__panel" role="dialog" aria-modal="true">
      <button type="button" class="mobile-nav__close" data-mobile-nav-close>
        <span class="visually-hidden">{{ 'general.accessibility.close' | t }}</span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke-linecap="round"/></svg>
      </button>
      <ul class="mobile-nav__list">
        {% for link in section.settings.menu.links %}
          <li>
            {{ link.title | link_to: link.url }}
            {% if link.links.size > 0 %}
              <ul class="mobile-nav__sublist">
                {% for childlink in link.links %}
                  <li>{{ childlink.title | link_to: childlink.url }}</li>
                {% endfor %}
              </ul>
            {% endif %}
          </li>
        {% endfor %}
      </ul>
    </div>
  </div>

  <div class="search-flyout" data-search-flyout aria-hidden="true">
    <div class="search-flyout__overlay" data-search-flyout-overlay></div>
    <div class="search-flyout__panel" role="dialog" aria-modal="true">
      <predictive-search data-predictive-search-url="{{ routes.predictive_search_url }}">
        <form action="{{ routes.search_url }}" method="get" role="search" class="search-flyout__form">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4" stroke-linecap="round"/></svg>
          <input
            type="search"
            name="q"
            value="{{ search.terms | escape }}"
            placeholder="{{ 'search.placeholder' | t }}"
            aria-label="{{ 'search.placeholder' | t }}"
            aria-expanded="false"
            aria-owns="predictive-search-results"
            aria-controls="predictive-search-results"
            aria-haspopup="listbox"
            aria-autocomplete="list"
            data-search-input
          >
          <button type="button" class="search-flyout__close" data-search-flyout-close>
            <span class="visually-hidden">{{ 'general.accessibility.close' | t }}</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke-linecap="round"/></svg>
          </button>
        </form>
        <div class="search-flyout__results" data-predictive-search-mount hidden></div>
      </predictive-search>
    </div>
  </div>
</header>

<script src="{{ 'predictive-search.js' | asset_url }}" defer="defer"></script>

{% stylesheet %}
  .header {
    height: 5rem;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    justify-content: space-between;
  }
  .header a {
    position: relative;
    text-decoration: none;
    color: var(--color-foreground);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .header__title {
    font-size: 1.25rem;
    margin: 0;
    white-space: nowrap;
  }
  .header__title img {
    width: var(--logo-width, 140px);
    max-width: 100%;
    height: auto;
  }
  .header a sup {
    position: absolute;
    top: -4px;
    right: -4px;
    background: var(--color-accent);
    color: var(--color-accent-foreground);
    font-size: 0.6rem;
    line-height: 1;
    min-width: 16px;
    height: 16px;
    border-radius: 999px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .header svg {
    width: 1.5rem;
    height: 1.5rem;
  }
  .header__icons {
    display: flex;
    gap: 1rem;
    align-items: center;
  }
  .header__icon-link {
    cursor: pointer;
  }
  .header__search-toggle {
    background: none;
    border: none;
    padding: 0;
    color: var(--color-foreground);
  }

  .search-flyout {
    position: fixed;
    inset: 0;
    z-index: 110;
    display: none;
  }
  .search-flyout.is-open {
    display: block;
  }
  .search-flyout__overlay {
    position: absolute;
    inset: 0;
    background: rgba(15, 23, 42, 0.4);
  }
  .search-flyout__panel {
    position: relative;
    max-width: 40rem;
    margin: 10vh auto 0;
    background: var(--color-background);
    border-radius: var(--style-border-radius-card);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.15);
    overflow: hidden;
  }
  .search-flyout__form {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem 1.25rem;
    border-bottom: 1px solid var(--color-border);
  }
  .search-flyout__form svg {
    flex-shrink: 0;
    color: var(--color-muted);
  }
  .search-flyout__form input {
    flex: 1;
    border: none;
    font: inherit;
    background: none;
    color: var(--color-foreground);
  }
  .search-flyout__form input:focus {
    outline: none;
  }
  .search-flyout__close {
    background: none;
    border: none;
    color: var(--color-foreground);
    flex-shrink: 0;
  }
  .search-flyout__results {
    max-height: 60vh;
    overflow-y: auto;
  }

  @media (max-width: 749px) {
    .search-flyout__panel {
      margin: 0;
      max-width: none;
      height: 100%;
      border-radius: 0;
    }
  }

  .header__menu-toggle {
    display: none;
    background: none;
    border: none;
    padding: 0.5rem;
    color: var(--color-foreground);
  }

  /* Desktop nav */
  .header__menu ul {
    list-style: none;
    display: flex;
    gap: 1.75rem;
    margin: 0;
    padding: 0;
  }
  .header__menu-item {
    position: relative;
  }
  .header__menu-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    background: none;
    border: none;
    font: inherit;
    color: var(--color-foreground);
    cursor: pointer;
    padding: 0;
  }
  .header__menu-link svg {
    width: 1rem;
    height: 1rem;
    transition: transform 0.15s ease;
  }
  .header__submenu {
    list-style: none;
    margin: 0;
    padding: 0.5rem;
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 200px;
    background: var(--color-background);
    border: 1px solid var(--color-border);
    border-radius: var(--style-border-radius-card);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
    opacity: 0;
    visibility: hidden;
    transform: translateY(4px);
    transition: opacity 0.15s ease, transform 0.15s ease, visibility 0.15s;
    z-index: 20;
  }
  .header__submenu li a {
    display: block;
    padding: 0.5rem 0.75rem;
    border-radius: calc(var(--style-border-radius-card) - 8px);
  }
  .header__submenu li a:hover {
    background: var(--color-border);
  }
  .header__menu-item.is-open .header__submenu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }
  .header__menu-item.is-open .header__menu-link svg {
    transform: rotate(180deg);
  }

  /* Mobile nav */
  .mobile-nav {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: none;
  }
  .mobile-nav.is-open {
    display: block;
  }
  .mobile-nav__overlay {
    position: absolute;
    inset: 0;
    background: rgba(15, 23, 42, 0.4);
  }
  .mobile-nav__panel {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    width: min(320px, 85vw);
    background: var(--color-background);
    padding: 1.5rem;
    overflow-y: auto;
  }
  .mobile-nav__close {
    background: none;
    border: none;
    color: var(--color-foreground);
    padding: 0.5rem;
    margin-bottom: 1rem;
  }
  .mobile-nav__close svg {
    width: 1.25rem;
    height: 1.25rem;
  }
  .mobile-nav__list,
  .mobile-nav__sublist {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .mobile-nav__list > li {
    border-bottom: 1px solid var(--color-border);
  }
  .mobile-nav__list a {
    display: block;
    padding: 0.85rem 0;
    justify-content: flex-start;
  }
  .mobile-nav__sublist {
    padding-left: 1rem;
  }

  @media (max-width: 749px) {
    .header__menu-toggle {
      display: flex;
    }
    .header__menu {
      display: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    document.querySelectorAll('.header__menu-item.has-submenu').forEach(function (item) {
      var button = item.querySelector('.header__menu-link');
      function open() {
        item.classList.add('is-open');
        button.setAttribute('aria-expanded', 'true');
      }
      function close() {
        item.classList.remove('is-open');
        button.setAttribute('aria-expanded', 'false');
      }
      button.addEventListener('click', function () {
        if (item.classList.contains('is-open')) {
          close();
        } else {
          open();
        }
      });
      item.addEventListener('mouseenter', open);
      item.addEventListener('mouseleave', close);
      item.addEventListener('focusout', function (e) {
        if (!item.contains(e.relatedTarget)) close();
      });
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') close();
      });
    });

    var toggle = document.querySelector('[data-mobile-nav-toggle]');
    var nav = document.querySelector('[data-mobile-nav]');
    if (toggle && nav) {
      var overlay = nav.querySelector('[data-mobile-nav-overlay]');
      var closeBtn = nav.querySelector('[data-mobile-nav-close]');

      function openNav() {
        nav.classList.add('is-open');
        nav.setAttribute('aria-hidden', 'false');
        toggle.setAttribute('aria-expanded', 'true');
        document.body.style.overflow = 'hidden';
        var focusable = nav.querySelector('a, button');
        if (focusable) focusable.focus();
      }
      function closeNav() {
        nav.classList.remove('is-open');
        nav.setAttribute('aria-hidden', 'true');
        toggle.setAttribute('aria-expanded', 'false');
        document.body.style.overflow = '';
        toggle.focus();
      }

      toggle.addEventListener('click', openNav);
      if (closeBtn) closeBtn.addEventListener('click', closeNav);
      if (overlay) overlay.addEventListener('click', closeNav);
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && nav.classList.contains('is-open')) closeNav();
      });
    }

    var searchToggle = document.querySelector('[data-search-toggle]');
    var searchFlyout = document.querySelector('[data-search-flyout]');
    if (searchToggle && searchFlyout) {
      var searchOverlay = searchFlyout.querySelector('[data-search-flyout-overlay]');
      var searchClose = searchFlyout.querySelector('[data-search-flyout-close]');
      var searchInput = searchFlyout.querySelector('[data-search-input]');

      function openSearch() {
        searchFlyout.classList.add('is-open');
        searchFlyout.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
        if (searchInput) searchInput.focus();
      }
      function closeSearch() {
        searchFlyout.classList.remove('is-open');
        searchFlyout.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
        searchToggle.focus();
      }

      searchToggle.addEventListener('click', openSearch);
      if (searchClose) searchClose.addEventListener('click', closeSearch);
      if (searchOverlay) searchOverlay.addEventListener('click', closeSearch);
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && searchFlyout.classList.contains('is-open')) closeSearch();
      });
    }
  })();
{% endjavascript %}

{% schema %}
{
  "name": "t:general.header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu",
      "default": "main-menu"
    },
    {
      "type": "link_list",
      "id": "customer_account_menu",
      "label": "t:labels.customer_account_menu",
      "default": "customer-account-main-menu"
    }
  ]
}
{% endschema %}
