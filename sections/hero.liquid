{% comment %}
  Homepage hero banner: full-width background image with a heading,
  optional subheading, and a call-to-action button. Renders the page's
  <h1> since it's the first section on the home page template.
{% endcomment %}

{%- liquid
  assign hero_text_align = 'left'
  if section.settings.text_alignment == 'center'
    assign hero_text_align = 'center'
  endif
-%}
<div
  class="hero full-width{% if section.settings.image %} hero--has-image{% endif %}"
  style="--hero-align-items: {{ section.settings.text_alignment }}; --hero-text-align: {{ hero_text_align }}"
>
  {%- if section.settings.image -%}
    <div class="hero__media">
      {%- render 'image', image: section.settings.image, width: 2000, loading: 'eager' -%}
    </div>
  {%- endif -%}

  <div class="hero__content">
    {%- if section.settings.heading != blank -%}
      <h1 class="hero__heading">{{ section.settings.heading }}</h1>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <p class="hero__subheading">{{ section.settings.subheading }}</p>
    {%- endif -%}
    {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
      <a href="{{ section.settings.button_link }}" class="button hero__button">{{ section.settings.button_label }}</a>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .hero {
    position: relative;
    display: grid;
    grid-template-columns: var(--content-grid);
    min-height: 60vh;
    align-items: center;
  }
  .hero--has-image {
    color: #fff;
  }
  .hero__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .hero__media .image,
  .hero__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero--has-image .hero__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(15, 23, 42, 0.35);
  }
  .hero__content {
    position: relative;
    z-index: 1;
    grid-column: 2;
    display: flex;
    flex-direction: column;
    align-items: var(--hero-align-items, flex-start);
    text-align: var(--hero-text-align, left);
    gap: 1.25rem;
    max-width: 40rem;
    padding: 4rem 0;
  }
  .hero__subheading {
    font-size: 1.1rem;
    max-width: 40ch;
  }
  .hero__button {
    background: var(--color-foreground);
    color: var(--color-background);
    border-color: var(--color-foreground);
  }
  .hero--has-image .hero__button {
    background: #fff;
    color: var(--color-foreground);
    border-color: #fff;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:general.heading",
      "default": "Welcome to our store"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:labels.subheading",
      "default": "Quality goods, thoughtfully made."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:labels.button_label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:labels.button_link"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "t:labels.alignment",
      "options": [
        { "value": "flex-start", "label": "t:options.alignment.left" },
        { "value": "center", "label": "t:options.alignment.center" }
      ],
      "default": "flex-start"
    }
  ],
  "presets": [
    {
      "name": "t:general.hero"
    }
  ]
}
{% endschema %}
