{% comment %}
  This section is used in the blog template to render the blog page listing all
  articles within a blog, with an optional tag filter.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/blog
{% endcomment %}

<div class="blog-page">
  <h1 class="blog-page__title">{{ blog.title }}</h1>

  {%- if blog.all_tags.size > 0 -%}
    <ul class="blog-tags">
      <li>
        {%- if current_tags.size == 0 -%}
          <span class="is-active">{{ 'blog.all_tags' | t }}</span>
        {%- else -%}
          <a href="{{ blog.url }}">{{ 'blog.all_tags' | t }}</a>
        {%- endif -%}
      </li>
      {%- for tag in blog.all_tags -%}
        <li>
          {%- if current_tags contains tag -%}
            <span class="is-active">{{ tag }}</span>
          {%- else -%}
            {{ tag | link_to_tag: tag }}
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  {%- endif -%}

  {%- paginate blog.articles by 9 -%}
    {%- if blog.articles.size > 0 -%}
      <div class="blog-grid">
        {%- for article in blog.articles -%}
          {%- render 'article-card', article: article -%}
        {%- endfor -%}
      </div>
      {{ paginate | default_pagination }}
    {%- else -%}
      <p class="blog-empty">{{ 'blog.no_articles' | t }}</p>
    {%- endif -%}
  {%- endpaginate -%}
</div>

{% stylesheet %}
  .blog-page__title {
    margin-bottom: 1.25rem;
  }
  .blog-tags {
    list-style: none;
    margin: 0 0 2rem;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  .blog-tags a,
  .blog-tags span {
    display: inline-block;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 0.4rem 1rem;
    font-size: 0.85rem;
    text-decoration: none;
    color: inherit;
  }
  .blog-tags span.is-active {
    background: var(--color-foreground);
    color: var(--color-background);
    border-color: var(--color-foreground);
  }
  .blog-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem 1.5rem;
  }
  .blog-empty {
    color: var(--color-muted);
    padding: 3rem 0;
    text-align: center;
  }

  @media (max-width: 989px) {
    .blog-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 749px) {
    .blog-grid {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.blog",
  "settings": []
}
{% endschema %}
