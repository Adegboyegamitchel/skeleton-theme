{% comment %}
  Homepage featured-collection grid: a heading, a product grid pulled
  from a merchant-picked collection, and a "view all" link.
{% endcomment %}

<div class="featured-collection">
  <div class="featured-collection__header">
    {%- if section.settings.heading != blank -%}
      <h2 class="featured-collection__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.collection -%}
      <a href="{{ section.settings.collection.url }}" class="featured-collection__view-all">
        {{ 'general.view_all' | t }}
      </a>
    {%- endif -%}
  </div>

  {%- if section.settings.collection -%}
    <div class="product-grid" style="--columns-desktop: {{ section.settings.columns_desktop }}">
      {%- for product in section.settings.collection.products limit: section.settings.products_to_show -%}
        {%- render 'product-card', product: product -%}
      {%- endfor -%}
    </div>
  {%- endif -%}
</div>

{% stylesheet %}
  .featured-collection__header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }
  .featured-collection__heading {
    margin: 0;
  }
  .featured-collection__view-all {
    font-size: 0.9rem;
    color: var(--color-muted);
    text-decoration: underline;
    white-space: nowrap;
  }
  .product-grid {
    display: grid;
    grid-template-columns: repeat(var(--columns-desktop, 4), 1fr);
    gap: 1.5rem 1.25rem;
  }

  @media (max-width: 989px) {
    .product-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.featured_collection",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:general.heading",
      "default": "Featured products"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:general.collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "label": "t:labels.products_to_show",
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "t:labels.columns_desktop",
      "default": 4
    }
  ],
  "presets": [
    {
      "name": "t:general.featured_collection"
    }
  ]
}
{% endschema %}
